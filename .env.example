# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude model used for natural-language understanding + tool calling.
ANTHROPIC_MODEL=claude-sonnet-5

# Which brain to use: "auto" (Claude if ANTHROPIC_API_KEY is set, else Hermes,
# else rule-based fallback), "claude", "hermes", or "intents".
BRAIN=auto

# Hermes (Nous Research) runs locally via Ollama -- no API key needed.
# Install Ollama, then: ollama pull hermes3
HERMES_HOST=http://localhost:11434
HERMES_MODEL=hermes3

# Word that wakes the assistant up (case-insensitive).
WAKE_WORD=jarvis

# macOS `say` voice. Run `say -v ?` to list installed voices.
TTS_VOICE=Daniel

# Set to "false" to disable the run_shell_command tool entirely.
ALLOW_SHELL=true

# Set to "false" to skip the spoken confirmation before commands that look
# destructive (rm -rf, sudo, shutdown, dd, mkfs, etc.).
CONFIRM_DANGEROUS=true

# Seconds before a shell command is killed for taking too long.
SHELL_TIMEOUT=30
